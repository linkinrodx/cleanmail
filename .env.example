# ─── Microsoft (Outlook / Hotmail) OAuth2 ───────────────────────────────
# App registration: https://entra.microsoft.com → App registrations → New registration
# Supported account types: "Accounts in any org directory (multitenant) and personal Microsoft accounts"
# Redirect URI (platform: Mobile and desktop applications): http://localhost:8765/callback
# Enable "Allow public client flows" = Yes (we use PKCE, no secret needed)
MS_CLIENT_ID=your-microsoft-client-id
MS_TENANT=common
MS_AUTHORIZE_URL=https://login.microsoftonline.com/common/oauth2/v2.0/authorize
MS_TOKEN_URL=https://login.microsoftonline.com/common/oauth2/v2.0/token
MS_SCOPE=https://outlook.office365.com/IMAP.AccessAsUser.All offline_access

# ─── Google (Gmail) OAuth2 ─────────────────────────────────────────────
# App registration: https://console.cloud.google.com → APIs & Services → Credentials
# Application type: Desktop app
# Add authorized redirect URI: http://localhost:8765/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_SCOPE=https://mail.google.com/ https://www.googleapis.com/auth/userinfo.email

# ─── Shared OAuth callback (local loopback server in the bun process) ───
OAUTH_CALLBACK_PORT=8765
OAUTH_CALLBACK_PATH=/callback
