{
	"name": "cleanmail",
	"version": "0.0.1",
	"description": "A desktop webmail client cleaner",
	"packageManager": "bun@1.3.9",
	"scripts": {
		"build": "bun run build:web && electrobun build",
		"build:web": "vite build",
		"clean": "bunx rimraf dist build artifacts .turbo",
		"dev": "electrobun dev --watch",
		"dev:watch": "turbo run dev --watch --parallel",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"format:watch": "bun --watch scripts/format-watch.ts",
		"hmr": "vite --port 5173",
		"hmr:mock": "VITE_MOCK=true vite --port 5173",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"lint:watch": "bun --watch scripts/lint-watch.ts",
		"start": "turbo run hmr start:app",
		"start:app": "electrobun dev",
		"typecheck": "tsc --noEmit",
		"watch": "turbo run --ui tui format:watch lint:watch hmr start:app"
	},
	"dependencies": {
		"@base-ui/react": "^1.3.0",
		"@fontsource-variable/geist": "^5.2.8",
		"@lukemorales/query-key-factory": "^1.3.4",
		"@tanstack/react-form": "^1.28.5",
		"@tanstack/react-query": "^5.90.21",
		"@tanstack/react-router": "^1.166.7",
		"@tanstack/react-table": "^8.21.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"electrobun": "^1.15.1",
		"imapflow": "^1.2.13",
		"keytar": "^7.9.0",
		"lucide-react": "^0.577.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@faker-js/faker": "^10.3.0",
		"@tailwindcss/vite": "^4.2.1",
		"@tanstack/router-plugin": "^1.166.7",
		"@types/bun": "latest",
		"@types/node": "^22",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/three": "^0.180.0",
		"@vitejs/plugin-react": "^6.0.1",
		"shadcn": "^4.0.6",
		"tailwindcss": "^4",
		"turbo": "^2.8.14",
		"typescript": "^5.7.2",
		"vite": "^8.0.0"
	},
	"overrides": {
		"@types/node": "^22"
	}
}
